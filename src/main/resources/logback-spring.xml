<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"service":"mcp"}</customFields>
            <fieldNames>
                <timestamp>timestamp</timestamp>
                <version>[ignore]</version>
                <levelValue>[ignore]</levelValue>
            </fieldNames>
            <includeMdcKeyName>sessionId</includeMdcKeyName>
            <includeMdcKeyName>attachmentGroupId</includeMdcKeyName>
            <includeMdcKeyName>documentId</includeMdcKeyName>
            <includeMdcKeyName>tool</includeMdcKeyName>
            <includeMdcKeyName>statusCode</includeMdcKeyName>
            <includeMdcKeyName>status</includeMdcKeyName>
            <includeMdcKeyName>latencyMs</includeMdcKeyName>
            <includeMdcKeyName>event</includeMdcKeyName>
        </encoder>
    </appender>

    <!--
        Log de debug de curta retenção (prompt completo / texto anonimizado / resposta do
        modelo do Gemini) — "proibido logar ... em log de retenção
        longa; permitido apenas em log de debug de curta retenção (<= 7 dias), separado do
        log estruturado principal". Local (arquivo, não vai para o CloudWatch), nível DEBUG.
    -->
    <appender name="DEBUG_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/mcp-ai-debug.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/mcp-ai-debug.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"service":"mcp"}</customFields>
        </encoder>
    </appender>

    <logger name="br.com.triaige.mcpai.debug" level="DEBUG" additivity="false">
        <appender-ref ref="DEBUG_FILE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
